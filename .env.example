# ===== DeepSeek API 配置 =====
# 复制此文件为 .env 并填入你的 Key（.env 已被 .gitignore 排除，不会上传）
# 获取 Key: https://platform.deepseek.com

DEEPSEEK_API_KEY=sk-你的key在这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 匹配参数 =====
MATCH_THRESHOLD=70          # 低于此分不推荐投递（top10 会过滤）
MAX_CANDIDATES=50           # AI 精评的候选上限（控制花费）
LLM_CONCURRENCY=3           # 并发调用数，太高容易触发限流

# ===== 维度权重（会自动归一化，改这里就同时影响 prompt） =====
SKILL_WEIGHT=0.30
EXP_WEIGHT=0.20
CITY_WEIGHT=0.15
SALARY_WEIGHT=0.15
EDU_WEIGHT=0.10
COMPANY_WEIGHT=0.10

# ===== 成本估算（元 / 百万 token，按官方最新价格填） =====
DEEPSEEK_PRICE_IN=2.0
DEEPSEEK_PRICE_OUT=8.0

# ===== 爬虫 =====
# Chrome 路径（一般不用填，会自动从注册表/常见路径查找）
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
